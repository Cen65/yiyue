<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yiyue.mapper.DoctorMapper">
  <!-- 串行化同一医生的排班创建，保留跨院区冲突检查的原子性。 -->
  <select id="lock" resultType="java.lang.Long">SELECT id FROM doctor WHERE tenant_id = #{tenantId} AND id = #{id} FOR UPDATE</select>
</mapper>
