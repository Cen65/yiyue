# 复制为 .env 并填写随机值，或运行 scripts/Setup-Env.ps1 自动生成。
DB_PASSWORD=replace-with-random-password
REDIS_PASSWORD=replace-with-random-password
DEMO_ENABLED=true
DEMO_ADMIN_PASSWORD=replace-with-at-least-12-characters
DEMO_PATIENT_PASSWORD=replace-with-at-least-12-characters
COOKIE_SECURE=false

# 智能导诊默认关闭；密钥只在后端使用，填入后重启服务。
AI_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# 平台开户权限需独立初始化，默认关闭，不提升普通管理员权限。
PLATFORM_ADMIN_ENABLED=false
PLATFORM_ADMIN_PASSWORD=
